# Flask Configuration
SECRET_KEY=replace_with_your_own_secret_key
FLASK_ENV=development
PORT=5000

# Database Configuration (MySQL)
# If MySQL connection fails, application automatically falls back to SQLite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=cyber_career_copilot
USE_SQLITE_FALLBACK=True

# AI API Key (Optional)
# If left empty, Cyber Copilot seamlessly uses its intelligent predefined cyber knowledge base in Demo Mode
# Enter your Gemini API key (https://aistudio.google.com/) or OpenAI API key
GEMINI_API_KEY=
OPENAI_API_KEY=
